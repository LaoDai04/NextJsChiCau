generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model products_info {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  description String
  id_         Int    @map("id")
  name        String
  quantity    Int
}
